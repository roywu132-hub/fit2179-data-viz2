{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": "Australia States and Territories",
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {"type": "geojson"}
  },
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "fill": "#bae6fd",
    "stroke": "#1e40af",
    "strokeWidth": 2
  }
}
