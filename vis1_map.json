{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": "Major National Parks Distribution Across Australia",
  "projection": {"type": "mercator", "scale": 600, "translate": [400, 280]},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/alwaysblazing/Australia-State-TopoJson-MapChart/master/au-states-topo.json",
        "format": {"type": "topojson", "feature": "austates"}
      },
      "mark": {"type": "geoshape", "fill": "#e0f2fe", "stroke": "#64748b", "strokeWidth": 1.5}
    }
  ]
}
